# Canonical site URL used for metadata, sitemap and JSON-LD.
SITE_URL=https://wordsatrest.com

# First official Daily archive date (UTC, YYYY-MM-DD).
# Dates before this return 404 and are omitted from sitemap/archive.
# Calendar launch day (Asia/Shanghai): 2026-10-06.
DAILY_START=2026-10-06

# Set to any value to show visible ad placeholders in production builds (for layout QA).
# SHOW_AD_PLACEHOLDERS=1

# --- Analytics (paste real ID after creating GA4 property; leave unset to load nothing) ---
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- Ads (after AdSense approval) ---
# ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# --- Cookie / consent banner (stub). Set to 1 only when you are ready to show it. ---
# NEXT_PUBLIC_COOKIE_CONSENT=1

# --- Deploy (CI / non-interactive) ---
# CLOUDFLARE_ACCOUNT_ID=b79c11a97188ceeb150acb0b6c4cda97
# CLOUDFLARE_API_TOKEN=   # never commit
