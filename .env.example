# Canonical site URL used for metadata, sitemap and JSON-LD.
SITE_URL=https://wordsatrest.com
# First date (UTC, YYYY-MM-DD) of the Daily archive. Set to the real launch day.
DAILY_START=2026-10-01
# Set to any value to show visible ad placeholders in production builds (for layout QA).
# SHOW_AD_PLACEHOLDERS=1
# --- Later (not used yet) ---
# NEXT_PUBLIC_GA_ID=G-XXXXXXX
# ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# --- Deploy (CI / non-interactive) ---
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=   # "Edit Cloudflare Workers" template; never commit
